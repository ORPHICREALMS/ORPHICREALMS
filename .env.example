# realms.chat guest beta — no account system and no database.
NODE_ENV=development
PORT=10000
# Optional locally. Render Blueprint generates a stable secret automatically.
ORPHIC_GUEST_SECRET=replace-with-a-long-random-secret

# Optional API Buddy endpoint allowlist. Add exact hostnames for providers you control/use.
# This protects the server from being used to make requests to arbitrary internal endpoints.
BUDDY_ALLOWED_HOSTS=api.openai.com

# Optional STUN/TURN overrides for difficult networks. Basic peer-to-peer calls use a public STUN server.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# Sites allowed to connect the 3D Rooms page (comma list, or * for any)
ROOMS_ORIGINS=*
